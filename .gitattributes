# Normalisasi semua file teks ke LF
* text=auto eol=lf

# Go
*.go   text eol=lf
*.mod  text eol=lf
*.sum  text eol=lf

# Config & docs
*.yml  text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.env  text eol=lf
Makefile text eol=lf

# Shell scripts
*.sh text eol=lf

# Windows batch — tetap CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary — jangan disentuh
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.exe binary
